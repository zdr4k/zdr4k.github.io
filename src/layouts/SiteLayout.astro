---
import site from '../data/site.json';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Kelvin Santos — Security Engineer', description = site.intro } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090a0c" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="lab-bg" aria-hidden="true"></canvas>
    <div class="bg-vignette" aria-hidden="true"></div>
    <div class="container">
      <header class="header">
        <a class="brand" href="/" aria-label="Back to home"><span class="logo-mark">⌁</span>{site.brand}</a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/journal" aria-current={pathname.startsWith('/journal') ? 'page' : undefined}>Journal</a>
          <a href="/projects" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="https://github.com/zdr4k/DFIR-Field-Notes" target="_blank" rel="noopener noreferrer">Notes ↗</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer><span>© {new Date().getFullYear()} Kelvin Santos</span><span class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={site.medium} target="_blank" rel="noopener noreferrer">Medium</a></span></footer>
    </div>
    <script>
      (() => {
        const canvas = document.getElementById('lab-bg');
        if (!canvas) return;
    
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
    
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
    
        let width = 0;
        let height = 0;
        let animationFrame = 0;
        let particles = [];
        let mouse = { x: -9999, y: -9999 };
        // Quiet, occasional attack -> detection -> defense sequences.
        // The mesh itself stays the original softly animated particle network.
        let threatScene = null;
        let nextSceneAt = performance.now() + 2200;
        const SCENE_DURATION = 9400;
        const SCENE_PAUSE = 5300;
    
        const PARTICLE_COUNT = reduceMotion ? 0 : isMobile ? 56 : 106;
        const LINK_DISTANCE = isMobile ? 120 : 150;
        const MOUSE_RADIUS = 140;
    
        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * Math.min(window.devicePixelRatio || 1, 2);
          canvas.height = height * Math.min(window.devicePixelRatio || 1, 2);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(Math.min(window.devicePixelRatio || 1, 2), Math.min(window.devicePixelRatio || 1, 2));
          createParticles();
          threatScene = null;
          nextSceneAt = performance.now() + 2200;
        }
    
        function random(min, max) {
          return Math.random() * (max - min) + min;
        }
    
        function createParticles() {
          particles = [];
          for (let i = 0; i < PARTICLE_COUNT; i++) {
            particles.push({
              x: random(0, width),
              y: random(0, height),
              vx: random(-0.18, 0.18),
              vy: random(-0.18, 0.18),
              r: random(0.7, 1.8)
            });
          }
        }
    
        function drawBackground() {
          const gradient = ctx.createLinearGradient(0, 0, width, height);
          gradient.addColorStop(0, '#06070a');
          gradient.addColorStop(0.5, '#090b12');
          gradient.addColorStop(1, '#050608');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, width, height);
        }
    
        function updateParticles() {
          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
    
            if (p.x <= 0 || p.x >= width) p.vx *= -1;
            if (p.y <= 0 || p.y >= height) p.vy *= -1;
    
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
    
            if (dist < MOUSE_RADIUS && dist > 0) {
              const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS;
              p.x -= (dx / dist) * force * 0.35;
              p.y -= (dy / dist) * force * 0.35;
            }
          }
        }
    
        function drawConnections() {
          // This neutral mesh is unchanged from the published original.
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const a = particles[i];
              const b = particles[j];
              const dx = a.x - b.x;
              const dy = a.y - b.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
    
              if (dist < LINK_DISTANCE) {
                const opacity = (1 - dist / LINK_DISTANCE) * 0.16;
                ctx.strokeStyle = `rgba(170, 190, 255, ${opacity})`;
                ctx.lineWidth = 0.7;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
          }
        }

        // Real paths from the living mesh. Only one subdued sequence at a time.
        // Unlike the earlier colored-link experiment, the path is not reselected
        // every frame: its nodes keep moving naturally while the event unfolds.
        function startThreatScene(now) {
          const blockers = Array.from(document.querySelectorAll(
            'h1, .intro, .hero-role, .section-heading, .section-lead, .capability, .editorial-row, .project-card, .article, .socials'
          )).map(el => el.getBoundingClientRect()).filter(r =>
            r.bottom > 0 && r.top < height && r.right > 0 && r.left < width
          );
          const blocked = (x, y) => blockers.some(r =>
            x > r.left - 26 && x < r.right + 26 &&
            y > r.top - 22 && y < r.bottom + 22
          );
          const safe = particles.map(p => !blocked(p.x, p.y));
          const adjacency = particles.map((a, i) => particles
            .map((b, j) => ({ j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
            .filter(e => e.j !== i && safe[e.j] && e.d < LINK_DISTANCE * .79)
            .map(e => e.j)
          );

          // A hub is an existing particle, not a fixed artificial focal point.
          // Favor the visual margins, where routes won't compete with the text.
          const hubs = particles.map((p,i) => i).filter(i =>
            safe[i] && adjacency[i].length >= 3 &&
            (particles[i].x < width * .27 || particles[i].x > width * .73)
          );
          for(let attempt=0;attempt<15 && hubs.length;attempt++){
            const hub = hubs[Math.floor(Math.random()*hubs.length)];
            const available = adjacency[hub].slice().sort(()=>Math.random()-.5);
            const paths=[];
            for(const first of available){
              const secondOptions=adjacency[first].filter(j => j !== hub && safe[j]);
              if(!secondOptions.length)continue;
              const second=secondOptions[Math.floor(Math.random()*secondOptions.length)];
              const thirdOptions=adjacency[second].filter(j =>
                j !== first && j !== hub && safe[j]
              );
              const origin=thirdOptions.length
                ? thirdOptions[Math.floor(Math.random()*thirdOptions.length)]
                : second;
              const path=origin===second ? [second,first,hub] : [origin,second,first,hub];
              if(paths.some(p=>p.includes(first) || p[0]===path[0]))continue;
              paths.push(path);
              if(paths.length===2)break;
            }
            if(paths.length===2) {
              threatScene = {red:paths[0],blue:paths[1],hub,start:now};
              return;
            }
          }
          // If no useful local topology is available, quietly retry later.
          nextSceneAt = now + 2500;
        }

        function drawThreatScene(now) {
          if(reduceMotion)return;
          if(!threatScene) {
            if(now>=nextSceneAt)startThreatScene(now);
            if(!threatScene)return;
          }
          const scene=threatScene;
          const age=now-scene.start;
          if(age>=SCENE_DURATION){
            threatScene=null;
            nextSceneAt=now+SCENE_PAUSE;
            return;
          }
          const smooth = t => {
            const x=Math.max(0,Math.min(1,t));
            return x*x*(3-2*x);
          };
          const attackProgress=smooth(age/3650);
          const defenseProgress=smooth((age-3150)/3650);
          const entrance=smooth(age/700);
          const exit=1-smooth((age-8250)/1150);
          const fade=entrance*exit;
          // Edges follow actual particles. When they drift near the link
          // threshold, reduce intensity smoothly rather than jumping off.
          function drawRoute(indices, progress, rgb, opacity){
            const edgeCount=indices.length-1;
            const total=progress*edgeCount;
            for(let e=0;e<edgeCount;e++){
              const portion=Math.min(1,Math.max(0,total-e));
              if(portion<=0)continue;
              const a=particles[indices[e]];
              const b=particles[indices[e+1]];
              const distance=Math.hypot(a.x-b.x,a.y-b.y);
              const proximity=smooth((LINK_DISTANCE-distance)/(LINK_DISTANCE*.29));
              const alpha=opacity*fade*proximity;
              if(alpha<.002)continue;
              ctx.beginPath();
              ctx.moveTo(a.x,a.y);
              ctx.lineTo(a.x+(b.x-a.x)*portion,a.y+(b.y-a.y)*portion);
              ctx.strokeStyle=`rgba(${rgb}, ${alpha})`;
              ctx.lineWidth=.95;
              ctx.stroke();
            }
          }

          // Red approaches the monitored node; blue response follows shortly.
          // Red reduces intensity once blue arrives: a subtle containment cue.
          const contained=smooth((age-6150)/1150);
          drawRoute(scene.red, attackProgress, '235, 85, 110', .31*(1-.85*contained));
          drawRoute(scene.blue, defenseProgress, '70, 150, 245', .34);
          if(age>3200 && age<8050) {
            const node=particles[scene.hub];
            const detection=smooth((age-3200)/500)*
              (1-smooth((age-7350)/700))*fade;
            ctx.beginPath();
            ctx.arc(node.x,node.y,3.1,0,Math.PI*2);
            ctx.strokeStyle=`rgba(150, 186, 228, ${detection*.27})`;
            ctx.lineWidth=.75;
            ctx.stroke();
          }
        }
    
        function drawParticles() {
          for (const p of particles) {
            ctx.fillStyle = 'rgba(220, 228, 255, 0.38)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
    
        function draw() {
          drawBackground();
          updateParticles();
          drawConnections();
          drawThreatScene(performance.now());
          drawParticles();
          animationFrame = requestAnimationFrame(draw);
        }
    
        function handleMouseMove(event) {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        }
    
        function handleMouseLeave() {
          mouse.x = -9999;
          mouse.y = -9999;
        }
    
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', handleMouseMove);
        window.addEventListener('mouseleave', handleMouseLeave);
    
        resize();
    
        if (!reduceMotion) {
          draw();
        } else {
          drawBackground();
        }
      })();
    </script>
  </body>
</html>
