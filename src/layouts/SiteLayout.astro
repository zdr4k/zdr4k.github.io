---
import site from '../data/site.json';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Kelvin Santos — Security Engineer', description = site.intro } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090a0c" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="lab-bg" aria-hidden="true"></canvas>
    <div class="bg-vignette" aria-hidden="true"></div>
    <div class="container">
      <header class="header">
        <a class="brand" href="/" aria-label="Back to home"><span class="logo-mark">⌁</span>{site.brand}</a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/journal" aria-current={pathname.startsWith('/journal') ? 'page' : undefined}>Journal</a>
          <a href="/projects" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="https://github.com/zdr4k/DFIR-Field-Notes" target="_blank" rel="noopener noreferrer">Notes ↗</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer><span>© {new Date().getFullYear()} Kelvin Santos</span><span class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={site.medium} target="_blank" rel="noopener noreferrer">Medium</a></span></footer>
    </div>
    <script>
      (() => {
        const canvas = document.getElementById('lab-bg');
        if (!canvas) return;
    
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
    
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
    
        let width = 0;
        let height = 0;
        let animationFrame = 0;
        let particles = [];
        let mouse = { x: -9999, y: -9999 };
        // Keep colored path selections stable, then crossfade to new routes.
        let activeTraffic = [];
        let fadingTraffic = [];
        let trafficSelectedAt = -Infinity;
        const TRAFFIC_INTERVAL = 8000;
        const TRAFFIC_CROSSFADE = 2200;
    
        const PARTICLE_COUNT = reduceMotion ? 0 : isMobile ? 50 : 96;
        const LINK_DISTANCE = isMobile ? 120 : 150;
        const MOUSE_RADIUS = 140;
    
        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * Math.min(window.devicePixelRatio || 1, 2);
          canvas.height = height * Math.min(window.devicePixelRatio || 1, 2);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(Math.min(window.devicePixelRatio || 1, 2), Math.min(window.devicePixelRatio || 1, 2));
          createParticles();
          activeTraffic=[];
          fadingTraffic=[];
          trafficSelectedAt=-Infinity;
        }
    
        function random(min, max) {
          return Math.random() * (max - min) + min;
        }
    
        function createParticles() {
          particles = [];
          for (let i = 0; i < PARTICLE_COUNT; i++) {
            particles.push({
              x: random(0, width),
              y: random(0, height),
              vx: random(-0.18, 0.18),
              vy: random(-0.18, 0.18),
              r: random(0.7, 1.8)
            });
          }
        }
    
        function drawBackground() {
          const gradient = ctx.createLinearGradient(0, 0, width, height);
          gradient.addColorStop(0, '#06070a');
          gradient.addColorStop(0.5, '#090b12');
          gradient.addColorStop(1, '#050608');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, width, height);
        }
    
        function updateParticles() {
          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
    
            if (p.x <= 0 || p.x >= width) p.vx *= -1;
            if (p.y <= 0 || p.y >= height) p.vy *= -1;
    
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
    
            if (dist < MOUSE_RADIUS && dist > 0) {
              const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS;
              p.x -= (dx / dist) * force * 0.35;
              p.y -= (dy / dist) * force * 0.35;
            }
          }
        }
    
        function drawConnections() {
          // This neutral mesh is unchanged from the published original.
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const a = particles[i];
              const b = particles[j];
              const dx = a.x - b.x;
              const dy = a.y - b.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
    
              if (dist < LINK_DISTANCE) {
                const opacity = (1 - dist / LINK_DISTANCE) * 0.16;
                ctx.strokeStyle = `rgba(170, 190, 255, ${opacity})`;
                ctx.lineWidth = 0.7;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
          }
        }

        // A few connected attack/defense paths inside the ORIGINAL mesh.
        // Paths are held for 8 seconds and crossfade over 2.2 seconds,
        // instead of choosing new particles every animation frame.
        function selectTrafficPaths() {
          const blockers = Array.from(document.querySelectorAll(
            'h1, .intro, .hero-role, .section-heading, .section-lead, .capability, .editorial-row, .project-card, .article, .socials'
          )).map(el => el.getBoundingClientRect()).filter(r =>
            r.bottom > 0 && r.top < height && r.right > 0 && r.left < width
          );
          const blocked = (x, y) => blockers.some(r =>
            x > r.left - 22 && x < r.right + 22 &&
            y > r.top - 20 && y < r.bottom + 20
          );
          // Leave room for moving nodes so a path doesn't abruptly disappear.
          const routeLimit = LINK_DISTANCE * 0.82;
          const neighbors = particles.map((a, i) => particles
            .map((b, j) => ({j, d: Math.hypot(a.x-b.x, a.y-b.y)}))
            .filter(e => e.j !== i && e.d < routeLimit)
            .sort((a, b) => a.d - b.d));

          const zones = [
            {x:.10,y:.25,rgb:'70, 150, 245'},
            {x:.90,y:.25,rgb:'235, 85, 110'},
            {x:.12,y:.80,rgb:'235, 85, 110'},
            {x:.87,y:.79,rgb:'70, 150, 245'}
          ];
          const picked = [];
          for(const zone of zones) {
            const starts = particles.map((p,i) => ({
              i, score:Math.hypot(p.x-width*zone.x,p.y-height*zone.y)
            })).filter(c => neighbors[c.i].length > 0 &&
              !blocked(particles[c.i].x,particles[c.i].y)
            ).sort((a,b)=>a.score-b.score);

            let path = [];
            for(const start of starts.slice(0,8)) {
              let current=start.i, previous=-1;
              const edges=[];
              for(let hop=0;hop<3;hop++) {
                const choices=neighbors[current].filter(e =>
                  e.j!==previous &&
                  !blocked(particles[e.j].x,particles[e.j].y) &&
                  !blocked((particles[current].x+particles[e.j].x)/2,
                           (particles[current].y+particles[e.j].y)/2)
                );
                if(!choices.length)break;
                const next=choices[Math.min(hop,choices.length-1)].j;
                edges.push({a:current,b:next,rgb:zone.rgb});
                previous=current;
                current=next;
              }
              if(edges.length>path.length)path=edges;
              if(path.length===3)break;
            }
            picked.push(...path);
          }
          return picked;
        }

        function drawTrafficPaths(now) {
          if(now-trafficSelectedAt >= TRAFFIC_INTERVAL) {
            fadingTraffic=activeTraffic;
            activeTraffic=selectTrafficPaths();
            trafficSelectedAt=now;
          }
          const blend=Math.min(1,Math.max(0,(now-trafficSelectedAt)/TRAFFIC_CROSSFADE));
          const drawSet=(set,weight)=>{
            if(weight<=0)return;
            for(const edge of set) {
              const a=particles[edge.a], b=particles[edge.b];
              const d=Math.hypot(a.x-b.x,a.y-b.y);
              // Fade approaching the connection limit; never snap off.
              const proximity=Math.min(1,Math.max(0,(LINK_DISTANCE-d)/(LINK_DISTANCE*.22)));
              const opacity=(.085+.15*proximity)*weight*proximity;
              if(opacity<.003)continue;
              ctx.strokeStyle=`rgba(${edge.rgb}, ${opacity})`;
              ctx.lineWidth=.85;
              ctx.beginPath();
              ctx.moveTo(a.x,a.y);
              ctx.lineTo(b.x,b.y);
              ctx.stroke();
            }
          };
          drawSet(fadingTraffic,1-blend);
          drawSet(activeTraffic,blend);
          if(blend===1)fadingTraffic=[];
        }
    
        function drawParticles() {
          for (const p of particles) {
            ctx.fillStyle = 'rgba(220, 228, 255, 0.38)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
    
        function draw() {
          drawBackground();
          updateParticles();
          drawConnections();
          drawTrafficPaths(performance.now());
          drawParticles();
          animationFrame = requestAnimationFrame(draw);
        }
    
        function handleMouseMove(event) {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        }
    
        function handleMouseLeave() {
          mouse.x = -9999;
          mouse.y = -9999;
        }
    
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', handleMouseMove);
        window.addEventListener('mouseleave', handleMouseLeave);
    
        resize();
    
        if (!reduceMotion) {
          draw();
        } else {
          drawBackground();
        }
      })();
    </script>
  </body>
</html>
