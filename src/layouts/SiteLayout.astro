---
import site from '../data/site.json';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Kelvin Santos — Security Engineer', description = site.intro } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090a0c" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="lab-bg" aria-hidden="true"></canvas>
    <div class="bg-vignette" aria-hidden="true"></div>
    <div class="container">
      <header class="header">
        <a class="brand" href="/" aria-label="Back to home"><span class="logo-mark">⌁</span>{site.brand}</a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/journal" aria-current={pathname.startsWith('/journal') ? 'page' : undefined}>Journal</a>
          <a href="/projects" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="https://github.com/zdr4k/DFIR-Field-Notes" target="_blank" rel="noopener noreferrer">Notes ↗</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer><span>© {new Date().getFullYear()} Kelvin Santos</span><span class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={site.medium} target="_blank" rel="noopener noreferrer">Medium</a></span></footer>
    </div>
    <script>
      (() => {
        const canvas = document.getElementById('lab-bg');
        if (!canvas) return;
    
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
    
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
    
        let width = 0;
        let height = 0;
        let animationFrame = 0;
        let particles = [];
        let mouse = { x: -9999, y: -9999 };
        // Quiet, occasional attack -> detection -> defense sequences.
        // The mesh itself stays the original softly animated particle network.
        let threatScene = null;
        let nextSceneAt = performance.now() + 900;
        const SCENE_DURATION = 6500;
        const SCENE_PAUSE_MIN = 1300;
        const SCENE_PAUSE_MAX = 2500;
    
        const PARTICLE_COUNT = reduceMotion ? 0 : isMobile ? 54 : 102;
        const LINK_DISTANCE = isMobile ? 120 : 150;
        const MOUSE_RADIUS = 140;
    
        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * Math.min(window.devicePixelRatio || 1, 2);
          canvas.height = height * Math.min(window.devicePixelRatio || 1, 2);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(Math.min(window.devicePixelRatio || 1, 2), Math.min(window.devicePixelRatio || 1, 2));
          createParticles();
          threatScene = null;
          nextSceneAt = performance.now() + 2600;
        }
    
        function random(min, max) {
          return Math.random() * (max - min) + min;
        }
    
        function createParticles() {
          particles = [];
          for (let i = 0; i < PARTICLE_COUNT; i++) {
            particles.push({
              x: random(0, width),
              y: random(0, height),
              vx: random(-0.18, 0.18),
              vy: random(-0.18, 0.18),
              r: random(0.7, 1.8)
            });
          }
        }
    
        function drawBackground() {
          const gradient = ctx.createLinearGradient(0, 0, width, height);
          gradient.addColorStop(0, '#06070a');
          gradient.addColorStop(0.5, '#090b12');
          gradient.addColorStop(1, '#050608');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, width, height);
        }
    
        function updateParticles() {
          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
    
            if (p.x <= 0 || p.x >= width) p.vx *= -1;
            if (p.y <= 0 || p.y >= height) p.vy *= -1;
    
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
    
            if (dist < MOUSE_RADIUS && dist > 0) {
              const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS;
              p.x -= (dx / dist) * force * 0.35;
              p.y -= (dy / dist) * force * 0.35;
            }
          }
        }
    
        function drawConnections() {
          // This neutral mesh is unchanged from the published original.
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const a = particles[i];
              const b = particles[j];
              const dx = a.x - b.x;
              const dy = a.y - b.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
    
              if (dist < LINK_DISTANCE) {
                const opacity = (1 - dist / LINK_DISTANCE) * 0.16;
                ctx.strokeStyle = `rgba(170, 190, 255, ${opacity})`;
                ctx.lineWidth = 0.7;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
          }
        }

        // Real attack and response paths inside the ORIGINAL organic mesh.
        // There is at most one short event, followed by a long calm interval.
        const smoothstep = t => {
          const n = Math.max(0, Math.min(1, t));
          return n * n * (3 - 2 * n);
        };

        function startThreatScene(now) {
          const blockers = Array.from(document.querySelectorAll(
            'h1, .intro, .hero-role, .section-heading, .section-lead, ' +
            '.capability, .editorial-row, .project-card, .article, .socials'
          )).map(el => el.getBoundingClientRect()).filter(r =>
            r.bottom > 0 && r.top < height && r.right > 0 && r.left < width
          );
          const blocked = (x, y) => blockers.some(r =>
            x >= r.left - 28 && x <= r.right + 28 &&
            y >= r.top - 22 && y <= r.bottom + 22
          );

          const eligible = particles.map(p => !blocked(p.x, p.y));
          // Conservative local edges remain stable even as nodes drift.
          const adjacency = particles.map((p, i) => particles
            .map((q, j) => ({
              id: j,
              distance: Math.hypot(p.x - q.x, p.y - q.y)
            }))
            .filter(e => e.id !== i && eligible[e.id] &&
              e.distance < LINK_DISTANCE * .77 &&
              !blocked((p.x + particles[e.id].x)/2,
                       (p.y + particles[e.id].y)/2))
            .map(e => e.id)
          );

          // Choose a living node near the margins, not a fixed visual hub.
          const hubs = particles.map((p, i) => i).filter(i =>
            eligible[i] && adjacency[i].length >= 2 &&
            (particles[i].x < width * .31 || particles[i].x > width * .69)
          );

          function growFromHub(hub, initial, forbidden) {
            let best = null;
            // Explore varied connected branches to produce a 3-5 edge path.
            for (let trial = 0; trial < 20; trial++) {
              const trail = [hub, initial];
              while (trail.length < 6) {
                const current = trail[trail.length - 1];
                const options = adjacency[current].filter(n =>
                  !trail.includes(n) && !forbidden.has(n));
                if (!options.length) break;
                trail.push(options[Math.floor(Math.random()*options.length)]);
              }
              if(trail.length >= 3 && (!best || trail.length > best.length))
                best = trail;
              if(best && best.length >= 5) break;
            }
            return best ? best.reverse() : null;
          }

          for (let attempt = 0; attempt < 75 && hubs.length; attempt++) {
            const hub = hubs[Math.floor(Math.random()*hubs.length)];
            const exits = adjacency[hub].slice();
            if (exits.length < 2) continue;

            const hubP = particles[hub];
            // Prefer distinct incoming directions, not two parallel routes.
            let opposite = null, bestAngle = -2;
            for (let a = 0; a < exits.length; a++) {
              for (let b = a+1; b < exits.length; b++) {
                const pa=particles[exits[a]], pb=particles[exits[b]];
                const ax=pa.x-hubP.x, ay=pa.y-hubP.y;
                const bx=pb.x-hubP.x, by=pb.y-hubP.y;
                const dot=(ax*bx+ay*by) /
                  Math.max(1,Math.hypot(ax,ay)*Math.hypot(bx,by));
                if(dot < bestAngle || bestAngle === -2) {
                  opposite=[exits[a],exits[b]];
                  bestAngle=dot;
                }
              }
            }
            if (!opposite || bestAngle > .65) continue;
            const attack = growFromHub(hub, opposite[0], new Set([opposite[1]]));
            if (!attack) continue;
            const defense = growFromHub(
              hub, opposite[1], new Set(attack.slice(0,-1))
            );
            if (!defense) continue;

            threatScene = { red: attack, blue: defense, hub, start: now,
              threatType: Math.random() < .30 ? 'purple' : 'red' };
            return;
          }
          nextSceneAt = now + 750;
        }

        function drawThreatScene(now) {
          if (reduceMotion) return;
          if (!threatScene) {
            if (now >= nextSceneAt) startThreatScene(now);
            if (!threatScene) return;
          }

          const scene = threatScene;
          const age = now - scene.start;
          if (age >= SCENE_DURATION) {
            threatScene = null;
            nextSceneAt = now + SCENE_PAUSE_MIN +
              Math.random() * (SCENE_PAUSE_MAX - SCENE_PAUSE_MIN);
            return;
          }

          const fadeIn = smoothstep(age / 650);
          const fadeOut = 1 - smoothstep((age - 5700) / 750);
          const fade = fadeIn * fadeOut;

          // Draw a continuous route from its origin toward the SAME hub.
          // Every visible edge shares one opacity: individual segments no
          // longer disappear while neighboring segments stay illuminated.
          function drawRoute(indices, progress, rgb, alpha) {
            const segments = indices.length - 1;
            const traveled = progress * segments;
            const opacity = alpha * fade;
            if (opacity < .002) return;

            ctx.strokeStyle = `rgba(${rgb}, ${opacity})`;
            ctx.lineWidth = 1.25;
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            ctx.beginPath();
            const origin = particles[indices[0]];
            ctx.moveTo(origin.x, origin.y);

            let tipX = origin.x;
            let tipY = origin.y;
            for (let i = 0; i < segments; i++) {
              const amount = Math.max(0, Math.min(1, traveled - i));
              if (amount <= 0) break;
              const a = particles[indices[i]];
              const b = particles[indices[i + 1]];
              tipX = a.x + (b.x - a.x) * amount;
              tipY = a.y + (b.y - a.y) * amount;
              ctx.lineTo(tipX, tipY);
              if (amount < 1) break;
            }
            ctx.stroke();

            // The response has one clear advancing tip, not isolated sparks
            // on disconnected edges. A tiny point helps track its direction.
            if (progress > 0 && progress < 1) {
              ctx.fillStyle = `rgba(${rgb}, ${opacity * .8})`;
              ctx.beginPath();
              ctx.arc(tipX, tipY, 1.7, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          // Intrusion -> detection -> blue response -> contained -> calm.
          const attackProgress = smoothstep(age / 2600);
          const defenseProgress = smoothstep((age - 2200) / 2450);
          const containment = smoothstep((age - 4750) / 850);
          const threatColor = scene.threatType === 'purple'
            ? '168, 102, 255'
            : '245, 92, 118';
          const threatOpacity = scene.threatType === 'purple' ? .54 : .56;
          drawRoute(scene.red, attackProgress, threatColor,
            threatOpacity * (1 - containment * .88));
          drawRoute(scene.blue, defenseProgress, '84, 163, 255', .58);

          const ring = smoothstep((age - 2380) / 350) *
            (1 - smoothstep((age - 3350) / 700)) * fade;
          if (ring > .003) {
            const p = particles[scene.hub];
            ctx.beginPath();
            ctx.arc(p.x,p.y,4.2,0,Math.PI*2);
            ctx.strokeStyle = `rgba(166, 206, 255, ${ring * .30})`;
            ctx.lineWidth = .95;
            ctx.stroke();
          }
        }

        function drawParticles() {
          for (const p of particles) {
            ctx.fillStyle = 'rgba(220, 228, 255, 0.38)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
    
        function draw() {
          drawBackground();
          updateParticles();
          drawConnections();
          drawThreatScene(performance.now());
          drawParticles();
          animationFrame = requestAnimationFrame(draw);
        }
    
        function handleMouseMove(event) {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        }
    
        function handleMouseLeave() {
          mouse.x = -9999;
          mouse.y = -9999;
        }
    
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', handleMouseMove);
        window.addEventListener('mouseleave', handleMouseLeave);
    
        resize();
    
        if (!reduceMotion) {
          draw();
        } else {
          drawBackground();
        }
      })();
    </script>
  </body>
</html>
