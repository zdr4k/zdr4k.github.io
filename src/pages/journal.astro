---
import Layout from '../layouts/SiteLayout.astro';
import site from '../data/site.json';
type Article={title:string;description?:string;url:string;label?:string};
const files=import.meta.glob('../data/articles/*.json',{eager:true,import:'default'});
const articles=(Object.entries(files) as [string,Article][]).sort(([a],[b])=>a.localeCompare(b)).map(([,item])=>item).filter(item=>!item.title.toLowerCase().startsWith('more writing'));
const categories=[...new Set(articles.map(a=>a.label??'Research'))];
---
<Layout title="Security Research Journal — Kelvin Santos" description="Investigations, field notes and experiments in security engineering.">
  <section class="page-intro">
    <div class="section-kicker">RESEARCH / FIELD NOTES / EXPERIMENTS</div>
    <h1>Security Research Journal.</h1>
    <p class="intro">Investigations, technical writing, and experiments from the lab.</p>
  </section>
  <section class="section" aria-label="Journal entries">
    <div class="filter-bar"><button class="filter-chip is-active" data-category="all" type="button">All</button>{categories.map(cat=><button class="filter-chip" data-category={cat} type="button">{cat}</button>)}</div>
    <div class="article-list">{articles.map(a=><a class="article journal-entry" data-label={a.label??'Research'} href={a.url} target="_blank" rel="noopener noreferrer"><div><span class="article-label">{a.label??'Research'}</span><h3>{a.title}</h3>{a.description&&<p>{a.description}</p>}</div><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
    <p id="journal-empty" class="empty-state" hidden>No entries in this category yet.</p>
    <div class="journal-footer"><a href={site.medium} target="_blank" rel="noopener noreferrer">All writing on Medium ↗</a></div>
  </section>
  <script>
    const buttons=document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const entries=document.querySelectorAll<HTMLElement>('.journal-entry');
    const empty=document.getElementById('journal-empty');
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const category=button.dataset.category;
      buttons.forEach(b=>b.classList.toggle('is-active',b===button));
      let visible=0;
      entries.forEach(entry=>{
        const show=category==='all'||entry.dataset.label===category;
        entry.hidden=!show;
        if(show)visible++;
      });
      if(empty)empty.hidden=visible>0;
    }));
  </script>
</Layout>
