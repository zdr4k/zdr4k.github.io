---
import Layout from '../layouts/SiteLayout.astro';
import site from '../data/site.json';
const projectFiles = import.meta.glob('../data/projects/*.json', { eager: true, import: 'default' });
const articleFiles = import.meta.glob('../data/articles/*.json', { eager: true, import: 'default' });
type Project = {title:string;description?:string;url:string;tags?:string[];featured?:boolean};
type Article = {title:string;description?:string;url:string;label?:string};
const projects=(Object.entries(projectFiles) as [string,Project][]).sort(([a],[b])=>a.localeCompare(b)).map(([,item])=>item).filter(p=>p.featured).slice(0,3);
const articles=(Object.entries(articleFiles) as [string,Article][]).sort(([a],[b])=>a.localeCompare(b)).map(([,item])=>item).filter(a=>!a.title.toLowerCase().startsWith('more writing')).slice(0,3);
---
<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="eyebrow"><span class="dot"></span>{site.eyebrow}</div>
    <h1 id="hero-title">{site.headline}</h1>
    <p class="hero-role">{site.hero_role}</p>
    <p class="intro">{site.intro}</p>
    <div class="actions">
      <a class="button primary" href="#about">About me ↓</a>
      <a class="button" href="/projects">View projects ↗</a>
    </div>
    <div class="hero-footnote" aria-label="Focus areas">
      {site.specialties.map((item, index) => <span>{index > 0 && <span class="hero-separator" aria-hidden="true">/</span>}{item}</span>)}
    </div>
  </section>
  {site.show_about && <section class="section editorial-section about-section" id="about" aria-labelledby="about-title">
    <div class="section-heading"><div><div class="section-kicker">01 / ABOUT</div><h2 id="about-title">About me</h2></div></div>
    <p class="section-lead">{site.about}</p>
    <div class="about-links"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
  </section>}
  <section class="section editorial-section" id="capabilities" aria-labelledby="capabilities-title">
    <div class="section-heading"><div><div class="section-kicker">02 / CORE CAPABILITIES</div><h2 id="capabilities-title">What I bring to the table.</h2></div></div>
    <div class="capabilities-grid">
      {site.skills.map((skill,i) => <div class="capability">
        <span class="capability-num">/ {String(i+1).padStart(2,'0')}</span>
        <h3>{skill.title}</h3>
        <p>{skill.detail}</p>
      </div>)}
    </div>
  </section>
  <section class="section editorial-section" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><div><div class="section-kicker">03 / PROFESSIONAL EXPERIENCE</div><h2 id="experience-title">Experience</h2></div></div>
    <p class="section-lead">{site.experience_intro}</p>
    <div class="editorial-list experience-list">
      {site.experience_items.map((item, i)=><div class="editorial-row"><span class="row-index">{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}
    </div>
  </section>
  {site.show_projects && <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><div><div class="section-kicker">04 / SELECTED WORK</div><h2 id="projects-title">Featured Projects</h2></div><a class="see-all" href="/projects">All projects ↗</a></div>
    <div class="project-grid compact-grid">
      {projects.map(p=><a class="project-card" href={p.url} target="_blank" rel="noopener noreferrer"><div class="card-top"><span class="folder-icon" aria-hidden="true">⌑</span><span class="arrow" aria-hidden="true">↗</span></div><h3>{p.title}</h3><p>{p.description}</p><div class="project-tags">{(p.tags??[]).map(t=><span>{t}</span>)}</div></a>)}
    </div>
  </section>}
  {site.show_research && <section class="section" id="research" aria-labelledby="research-title">
    <div class="section-heading"><div><div class="section-kicker">05 / TECHNICAL WRITING</div><h2 id="research-title">Writing & Notes</h2></div><a class="see-all" href="/journal">View journal ↗</a></div>
    <div class="article-list">{articles.map(a=><a class="article" href={a.url} target="_blank" rel="noopener noreferrer"><div><span class="article-label">{a.label??'Research'}</span><h3>{a.title}</h3>{a.description&&<p>{a.description}</p>}</div><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>}
  <section class="section about" id="contact" aria-labelledby="contact-title">
    <div class="section-kicker">06 / CONTACT</div>
    <h2 id="contact-title">Let’s connect.</h2>
    <p>Interested in SOC engineering, detection, automation, or security collaboration? You can find me on LinkedIn, GitHub, or Medium.</p>
    <div class="socials"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={site.medium} target="_blank" rel="noopener noreferrer">Medium ↗</a></div>
  </section>
</Layout>
