---
import Layout from '../layouts/SiteLayout.astro';
import site from '../data/site.json';

type Project = { title: string; description?: string; url: string; tags?: string[]; featured?: boolean };
type Article = { title: string; description?: string; url: string; label?: string };
const projectFiles = import.meta.glob('../data/projects/*.json', { eager: true, import: 'default' });
const articleFiles = import.meta.glob('../data/articles/*.json', { eager: true, import: 'default' });
const projects = (Object.entries(projectFiles) as [string, Project][])
  .sort(([a],[b])=>a.localeCompare(b))
  .map(([,item])=>item).filter(item=>item.featured).slice(0,3);
const articles = (Object.entries(articleFiles) as [string, Article][])
  .sort(([a],[b])=>a.localeCompare(b))
  .map(([,item])=>item)
  .filter(item=>!item.title.toLowerCase().startsWith('more writing')).slice(0,3);
---
<Layout visualMode="telemetry">
  <div class="experiment-flag" aria-label="Experimental page design">DESIGN EXPLORATION <span class="flag-dot"></span> TELEMETRY / V3</div>
  <section class="hero hero-wide" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="dot"></span>{site.eyebrow}</div>
      <h1 id="hero-title">Engineering<br /><span class="hero-quiet">better security</span><br />operations<span class="accent-period">.</span></h1>
      <p class="hero-role">Kelvin Santos <span class="role-line" aria-hidden="true"></span> {site.hero_role}</p>
      <p class="intro">{site.intro}</p>
      <div class="actions">
        <a class="button primary" href="#capabilities">Explore capabilities <span aria-hidden="true">↘</span></a>
        <a class="button button-quiet" href="/projects">Selected projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-meta">
        <span>DETECTION ENGINEERING</span>
        <span>SOAR & AUTOMATION</span>
        <span>INCIDENT RESPONSE</span>
      </div>
    </div>
    <div class="hero-visual" aria-label="Abstract diagram of a SOC workflow from telemetry through detection and response">
      <div class="visual-topline"><span>ENGINEERING / OPERATIONS</span><span>FIG. 01</span></div>
      <svg class="soc-diagram" viewBox="0 0 520 385" fill="none" role="img" aria-label="Stylized connected workflow: telemetry to detection to response">
        <defs>
          <linearGradient id="route-glow" x1="20" y1="180" x2="495" y2="180" gradientUnits="userSpaceOnUse"><stop stop-color="#6d8795" stop-opacity=".12"/><stop offset=".55" stop-color="#87cbba" stop-opacity=".56"/><stop offset="1" stop-color="#6d8795" stop-opacity=".15"/></linearGradient>
          <radialGradient id="node-halo"><stop stop-color="#9acec2" stop-opacity=".18"/><stop offset="1" stop-color="#9acec2" stop-opacity="0"/></radialGradient>
        </defs>
        <path d="M15 70H505M15 161H505M15 252H505M15 343H505M70 18V367M194 18V367M318 18V367M442 18V367" stroke="#8d9caa" stroke-opacity=".075"/>
        <path d="M65 200L178 116L320 183L452 89M65 200L194 291L320 183L458 297M178 116L318 68L452 89M194 291L318 324L458 297" stroke="url(#route-glow)" stroke-width="1.1"/>
        <path d="M65 200L178 116L320 183L452 89" stroke="#9bcabb" stroke-opacity=".42" stroke-width="1.3" stroke-dasharray="3 10" class="diagram-trace"/>
        <circle cx="320" cy="183" r="90" fill="url(#node-halo)"/>
        <circle cx="320" cy="183" r="59" stroke="#8cc9b9" stroke-opacity=".24" stroke-dasharray="3 8"/>
        <circle cx="320" cy="183" r="38" fill="#0c171a" stroke="#9acdbf" stroke-opacity=".5"/>
        <circle cx="320" cy="183" r="5" fill="#9dd9c5"/>
        <g fill="#0c1418" stroke="#9bb1b7" stroke-opacity=".55"><circle cx="65" cy="200" r="7"/><circle cx="178" cy="116" r="7"/><circle cx="452" cy="89" r="7"/><circle cx="194" cy="291" r="7"/><circle cx="458" cy="297" r="7"/><circle cx="318" cy="68" r="4"/><circle cx="318" cy="324" r="4"/></g>
        <g fill="#adbac2" font-size="11" letter-spacing="2" font-family="ui-monospace, SFMono-Regular, Consolas, monospace"><text x="31" y="177">INGEST</text><text x="134" y="96">NORMALIZE</text><text x="284" y="239">DETECT</text><text x="405" y="68">TRIAGE</text><text x="403" y="321">RESPOND</text><text x="137" y="317">ENRICH</text></g>
        <circle r="3.5" fill="#b8ebd8" class="diagram-pulse"><animateMotion dur="9s" repeatCount="indefinite" path="M65 200L178 116L320 183L452 89"/></circle>
      </svg>
      <div class="visual-footer"><span class="visual-activity"><span></span> FLOW VISUALIZATION</span><span>NOT LIVE DATA</span></div>
    </div>
  </section>

  {site.show_about && <section id="about" class="section section-split home-section" aria-labelledby="about-title">
    <div class="section-intro"><span class="section-kicker">01 / ABOUT</span><h2 id="about-title">Built around<br />the SOC.</h2></div>
    <div class="section-body">
      <p class="about-statement">{site.about}</p>
      <div class="inline-links"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
    </div>
  </section>}

  <section class="section home-section" id="capabilities" aria-labelledby="capabilities-title">
    <div class="wide-section-heading"><div><span class="section-kicker">02 / ENGINEERING CAPABILITIES</span><h2 id="capabilities-title">What I bring to the table.</h2></div><p>Hands-on skills across the detection lifecycle, from telemetry to response.</p></div>
    <div class="capabilities-grid">
      {site.skills.map((skill,i)=><div class="capability" key={skill.title}>
        <span class="capability-num">/ {String(i+1).padStart(2,'0')}</span>
        <h3>{skill.title}</h3>
        <p>{skill.detail}</p>
      </div>)}
    </div>
  </section>

  <section class="section section-split home-section" id="experience" aria-labelledby="experience-title">
    <div class="section-intro"><span class="section-kicker">03 / EXPERIENCE</span><h2 id="experience-title">From signals<br />to outcomes.</h2><p class="section-intro-note">{site.experience_intro}</p></div>
    <div class="section-body experience-flow">
      {site.experience_items.map((item,i)=><div class="experience-entry" key={item.title}><span class="entry-index">{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}
    </div>
  </section>

  {site.show_projects && <section class="section home-section" id="projects" aria-labelledby="projects-title">
    <div class="wide-section-heading"><div><span class="section-kicker">04 / SELECTED PROJECTS</span><h2 id="projects-title">Proof of work.</h2></div><a class="section-more" href="/projects">Explore all projects <span aria-hidden="true">↗</span></a></div>
    <div class="wide-project-grid">
      {projects.map((project,i)=><a class="wide-project" key={project.title} href={project.url} target="_blank" rel="noopener noreferrer">
        <div class="project-top"><span>PROJECT / {String(i+1).padStart(2,'0')}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
        <div><h3>{project.title}</h3><p>{project.description}</p></div>
        <div class="project-tags">{(project.tags??[]).map(tag=><span>{tag}</span>)}</div>
      </a>)}
    </div>
  </section>}

  {site.show_research && <section class="section section-split home-section" id="research" aria-labelledby="research-title">
    <div class="section-intro"><span class="section-kicker">05 / WRITING</span><h2 id="research-title">Field notes<br />& writing.</h2><a class="section-more" href="/journal">Go to Journal ↗</a></div>
    <div class="section-body compact-articles">
      {articles.map(article=><a class="writing-entry" key={article.url} href={article.url} target="_blank" rel="noopener noreferrer"><div><span class="article-label">{article.label??'Technical writing'}</span><h3>{article.title}</h3></div><span class="writing-arrow" aria-hidden="true">↗</span></a>)}
      <a class="writing-notes-link" href="https://github.com/zdr4k/DFIR-Field-Notes" target="_blank" rel="noopener noreferrer">DFIR Field Notes on GitHub ↗</a>
    </div>
  </section>}

  <section class="section home-section contact-wide" id="contact" aria-labelledby="contact-title">
    <span class="section-kicker">06 / GET IN TOUCH</span>
    <div class="contact-grid"><h2 id="contact-title">Let's build<br />better defenses<span class="accent-period">.</span></h2><div><p>Interested in SOC engineering, detection automation, or incident response? Let's connect.</p><div class="socials"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={site.medium} target="_blank" rel="noopener noreferrer">Medium ↗</a></div></div></div>
  </section>
</Layout>
